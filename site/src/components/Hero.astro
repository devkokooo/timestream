---
import GithubMark from "./GithubMark.astro";
import { ANNOUNCEMENT_HREF, GITHUB_REPO } from "../lib/site";
---

<section class="relative overflow-hidden">
  <div class="mx-auto flex min-h-[min(88vh,52rem)] max-w-6xl flex-col items-center justify-center px-5 py-20 text-center md:px-8 md:py-28">
    <p class="eyebrow mb-5">A post-modern Git client, visualized TVA-style</p>
    <h1 class="m-0 font-display text-[clamp(3.2rem,12vw,7.5rem)] leading-[0.9] font-semibold tracking-[0.12em]">
      TIMESTREAM
    </h1>
    <a
      href={ANNOUNCEMENT_HREF}
      class="mt-7 inline-flex items-center gap-3 border border-tva-gold/35 bg-[#1b1713] px-3 py-2 text-[0.6875rem] uppercase tracking-[0.12em] text-tva-paper-dim hover:border-tva-orange hover:text-tva-gold-bright"
    >
      <span class="stamp stamp-gold stamp-flat">v0.1</span>
      <span>Initial release</span>
      <span class="text-tva-gold">Learn more →</span>
    </a>
    <a class="btn-primary mt-8" href={GITHUB_REPO} target="_blank" rel="noreferrer">
      <GithubMark />
      View on GitHub
    </a>
  </div>
</section>
