---
import DownloadButtons from "./DownloadButtons.astro";
import { ANNOUNCEMENT_HREF } from "../lib/site";
---

<section class="relative overflow-hidden">
  <div class="mx-auto flex min-h-[min(88vh,52rem)] max-w-6xl flex-col items-center justify-center px-5 py-16 text-center md:px-8 md:py-28">
    <p class="eyebrow mb-5">A TVA-styled Git client</p>
    <h1 class="m-0 font-display text-[clamp(2.4rem,11vw,7.5rem)] leading-[0.9] font-semibold tracking-[0.06em] md:tracking-[0.12em]">
      TIMESTREAM
    </h1>
    <a
      href={ANNOUNCEMENT_HREF}
      class="mt-7 inline-flex max-w-full flex-wrap items-center justify-center gap-x-3 gap-y-2 border border-tva-gold/35 bg-[#1b1713] px-3 py-2 text-[0.6875rem] uppercase tracking-[0.12em] text-tva-paper-dim hover:border-tva-orange hover:text-tva-gold-bright"
    >
      <span class="stamp stamp-gold stamp-flat">v0.1</span>
      <span>Initial release</span>
      <span class="text-tva-gold">Learn more →</span>
    </a>
    <DownloadButtons class="mt-8" align="center" github />
  </div>
</section>
