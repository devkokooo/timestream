---
import GithubMark from "./GithubMark.astro";
import DownloadButtons from "./DownloadButtons.astro";
import { GITHUB_REPO } from "../lib/site";

const links = [
  { href: "/#path", label: "Work path" },
  { href: "/#faq", label: "FAQ" },
  { href: "/blog/", label: "Dispatches" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-30 border-b border-tva-gold/16 bg-tva-concrete/92 backdrop-blur-[6px]"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-3 md:px-8">
    <a href="/" class="flex items-center gap-3">
      <img src="/timestream-logo.svg" alt="" class="size-8" width="32" height="32" />
      <span class="flex flex-col">
        <span class="eyebrow leading-none">Chronomonitoring</span>
        <span class="mt-1 font-display text-[0.8125rem] font-semibold tracking-[0.18em]">TIMESTREAM</span>
      </span>
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Bureau">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[0.6875rem] uppercase tracking-[0.16em] text-tva-paper-dim hover:text-tva-gold-bright"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <DownloadButtons compact />
      <a class="btn" href={GITHUB_REPO} target="_blank" rel="noreferrer">
        <GithubMark />
        <span class="hidden sm:inline">View on GitHub</span>
        <span class="sm:hidden">GitHub</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("site-header");
    if (!header) return;
    const sync = () => {
      document.documentElement.style.setProperty("--site-header", `${header.offsetHeight}px`);
    };
    sync();
    new ResizeObserver(sync).observe(header);
  })();
</script>
